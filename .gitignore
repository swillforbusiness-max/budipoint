# =============================================================================
# BUDIPOINT MONOREPO .GITIGNORE (Frontend React/Vite + Backend Laravel/PHP)
# =============================================================================

# Environment & Secret Configuration Files (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Node / Frontend Dependencies & Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
*.local
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Laravel / PHP Dependencies, Caches & Storage
/vendor/
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/pail
backend/storage/app/*
!backend/storage/app/.gitignore
!backend/storage/app/public/
backend/storage/app/public/*
!backend/storage/app/public/.gitignore
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/cache/data/
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore

# Local Databases
*.sqlite
*.sqlite-journal
backend/database/*.sqlite
backend/database/*.sqlite-journal

# Testing & Coverage
coverage/
.phpunit.result.cache
backend/.phpunit.result.cache
backend/.phpunit.cache/

# IDE, Editor & OS Artifacts
.idea/
.vscode/*
!.vscode/extensions.json
.fleet/
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini
